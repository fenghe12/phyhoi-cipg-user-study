{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhyHOI overall-rating author review export",
  "type": "object",
  "required": ["kind", "content_version", "allocation_version", "participant_id", "exported_at", "responses"],
  "properties": {
    "kind": {"const": "author_acceptance_not_formal_collection"},
    "content_version": {"type": "string"},
    "allocation_version": {"type": ["string", "null"]},
    "participant_id": {"type": "string"},
    "exported_at": {"type": "string", "format": "date-time"},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participant_id", "sample_id", "media_id", "source_task_id", "content_version", "presentation_order", "segment", "answered", "score", "reason", "language", "watch", "submitted_at"],
        "properties": {
          "participant_id": {"type": "string"},
          "sample_id": {"type": "string", "pattern": "^P[0-9]{3}$"},
          "media_id": {"type": "string"},
          "source_task_id": {"type": "string"},
          "content_version": {"type": "string"},
          "presentation_order": {"type": "integer", "minimum": 1, "maximum": 300},
          "segment": {"type": "integer", "minimum": 1, "maximum": 6},
          "answered": {"type": "boolean"},
          "score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
          "reason": {"type": "string"},
          "language": {"enum": ["zh", "en", "ja", null]},
          "submitted_at": {"type": ["string", "null"], "format": "date-time"},
          "watch": {
            "type": "object",
            "required": ["ranges", "duration", "coverage_seconds", "threshold_met"],
            "properties": {
              "ranges": {"type": "array", "items": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2}},
              "duration": {"type": ["number", "null"], "minimum": 0},
              "coverage_seconds": {"type": "number", "minimum": 0},
              "threshold_met": {"type": "boolean"}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"answered": {"const": false}}}, "then": {"properties": {"score": {"const": null}}}}
        ]
      }
    }
  }
}
